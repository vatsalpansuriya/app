# Copy this file to .env and fill in real values. NEVER commit .env.
# All of these are read server-side only (never exposed to the browser).

# --- Supabase (complaint persistence) ---
# From your Supabase project: Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public Storage bucket for uploaded images (defaults to complaint-images)
SUPABASE_BUCKET=complaint-images

# --- Dealer login ---
# The single password dealers type to unlock the dashboard, and a random
# string used to sign session tokens (any long random value).
DEALER_PASSWORD=choose-a-strong-password
AUTH_SECRET=replace-with-a-long-random-string

# --- Twilio SMS / WhatsApp (optional; messages are simulated if unset) ---
# From your Twilio Console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# SMS-capable number, e.g. +12025550123
TWILIO_FROM=
# WhatsApp sender, e.g. whatsapp:+14155238886 (Twilio sandbox)
TWILIO_WHATSAPP_FROM=
# Optional: a dealer phone that also receives 36h delay alerts
DEALER_ALERT_PHONE=

# --- App ---
# Public base URL used to build the live tracking link in messages.
APP_URL=https://app-customer-name-phone-number-comp.vercel.app
